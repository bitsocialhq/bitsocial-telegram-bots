{
    "name": "bitsocial-telegram-bots",
    "version": "0.1.0",
    "description": "Telegram feed bots for Bitsocial clients (5chan, Seedit, etc.)",
    "author": "Bitsocial Forge",
    "license": "GPL-3.0-or-later",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "start": "npx tsx src/index.ts",
        "start:5chan-feed": "BOT_NAME=5chan-feed npx tsx src/index.ts",
        "build": "tsc",
        "dev": "npx tsx --watch src/index.ts",
        "prettier": "prettier src/**/*.{js,ts} --write"
    },
    "dependencies": {
        "@pkcprotocol/pkc-js": "0.0.65",
        "dotenv": "17.4.2",
        "node-fetch": "3.3.2",
        "p-queue": "9.3.1",
        "telegraf": "4.16.3",
        "tslog": "4.11.0",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@types/node": "26.1.1",
        "prettier": "3.9.4",
        "tsx": "4.23.0",
        "vitest": "^4.1.10"
    },
    "packageManager": "yarn@4.17.0"
}
